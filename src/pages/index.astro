---
import Base from "../layouts/Base.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SectionCard from "../components/SectionCard.astro";
import { getChapters, getCourses, getSections } from "../lib/content";

const sections = await getSections();
const cards = await Promise.all(
  sections.map(async (section) => {
    const courses = await getCourses(section.id);
    const counts = await Promise.all(
      courses.map(async (course) => (await getChapters(course.id)).length),
    );
    return {
      section,
      courseIds: courses.map((course) => course.id),
      chapterTotal: counts.reduce((sum, n) => sum + n, 0),
    };
  }),
);
---

<Base title="Learning — разделы" description="AI-системы и веб-разработка. Курсы с теорией, командами и практикой.">
  <SiteHeader />
  <main class="mx-auto max-w-6xl px-6 pb-24 md:px-10">
    <section class="border-b border-line py-14 md:py-20">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em] text-accent">Портал</p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl leading-[1.15] tracking-tight md:text-5xl">
        Выбери раздел.<br />Пройди темы. Собери проект.
      </h1>
      <p class="mt-6 max-w-2xl font-serif text-lg leading-relaxed text-muted">
        Каждый раздел — набор курсов с целью, пилотом и практикой в репозитории.
        Прогресс глав сохраняется в этом браузере.
      </p>
    </section>

    <section>
      {
        cards.map(({ section, courseIds, chapterTotal }) => (
          <SectionCard
            slug={section.id}
            order={section.data.order}
            title={section.data.title}
            tagline={section.data.tagline}
            goal={section.data.goal}
            courseIds={courseIds}
            chapterTotal={chapterTotal}
          />
        ))
      }
    </section>
  </main>
</Base>
