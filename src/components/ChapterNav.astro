---
interface Item {
  slug: string;
  title: string;
  order: number;
  href: string;
  id: string;
}

interface Props {
  course: string;
  currentSlug: string;
  items: Item[];
}

const { course, currentSlug, items } = Astro.props;
---

<aside class="hidden w-[17.5rem] shrink-0 border-r border-line bg-panel lg:block">
  <nav class="sticky top-0 max-h-screen overflow-y-auto py-5" data-chapter-nav data-course={course}>
    <p class="px-5 pb-3 font-mono text-[10px] uppercase tracking-[0.18em] text-faint">
      Главы
    </p>
    <ol class="font-mono text-[12px]">
      {
        items.map((item) => (
          <li>
            <a
              href={item.href}
              data-astro-prefetch
              data-chapter-id={item.id}
              class:list={[
                "flex gap-3 border-l-2 px-5 py-2.5 leading-snug transition-colors",
                item.slug === currentSlug
                  ? "border-accent bg-raised text-ink"
                  : "border-transparent text-muted hover:bg-raised/60 hover:text-ink",
              ]}
            >
              <span class="w-5 shrink-0 text-faint" data-chapter-mark>
                {String(item.order).padStart(2, "0")}
              </span>
              <span>{item.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
</aside>
