---
interface Props {
  slug: string;
  order: number;
  title: string;
  tagline: string;
  goal: string;
  courseIds: string[];
  chapterTotal: number;
}

const { slug, order, title, tagline, goal, courseIds, chapterTotal } = Astro.props;
const n = String(order).padStart(2, "0");
---

<a
  href={`/tracks/${slug}`}
  data-astro-prefetch
  class="group grid gap-4 border-t border-line py-10 md:grid-cols-[4.5rem_1fr_11rem] md:gap-8"
  data-section-card
  data-prefixes={courseIds.join(",")}
  data-total={chapterTotal}
>
  <div class="font-mono text-sm text-accent">{n}</div>
  <div>
    <h2 class="font-serif text-3xl tracking-tight text-ink group-hover:text-accent">{title}</h2>
    <p class="mt-2 max-w-xl font-serif text-lg text-muted">{tagline}</p>
    <p class="mt-4 text-sm text-ink/90">
      <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-faint">Цель раздела</span>
      <span class="mt-1 block">{goal}</span>
    </p>
  </div>
  <div class="flex flex-col justify-end md:items-end md:text-right">
    <div class="w-full md:w-40">
      <div class="mb-1 flex justify-between font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
        <span>Прогресс</span>
        <span data-section-count>—</span>
      </div>
      <div class="h-[3px] bg-line">
        <div class="h-full bg-accent" data-progress-fill style="width: 0%"></div>
      </div>
    </div>
  </div>
</a>
