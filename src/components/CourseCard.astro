---
interface Props {
  href: string;
  slug: string;
  order: number;
  title: string;
  skill: string;
  goal: string;
  metric: string;
  pilot: string;
  chapterCount: number;
}

const { href, slug, order, title, skill, goal, metric, pilot, chapterCount } = Astro.props;
const n = String(order).padStart(2, "0");
---

<a
  href={href}
  data-astro-prefetch
  class="group grid gap-4 border-t border-line py-8 md:grid-cols-[4.5rem_1fr_11rem] md:gap-8 md:py-10"
  data-course-card
  data-course={slug}
  data-total={chapterCount}
>
  <div class="font-mono text-sm text-accent">{n}</div>
  <div>
    <h2 class="font-serif text-2xl tracking-tight text-ink group-hover:text-accent md:text-[1.75rem]">
      {title}
    </h2>
    <p class="mt-1 text-sm text-muted">{skill}</p>
    <dl class="mt-5 grid gap-3 text-sm md:grid-cols-2">
      <div>
        <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-faint">Цель</dt>
        <dd class="mt-1 text-ink/90">{goal}</dd>
      </div>
      <div>
        <dt class="font-mono text-[10px] uppercase tracking-[0.16em] text-faint">Пилот</dt>
        <dd class="mt-1 text-ink/90">{pilot}</dd>
      </div>
    </dl>
  </div>
  <div class="flex flex-col justify-between gap-4 md:items-end md:text-right">
    <p class="font-mono text-[11px] leading-relaxed text-muted">{metric}</p>
    <div class="w-full md:w-40">
      <div class="mb-1 flex justify-between font-mono text-[10px] uppercase tracking-[0.14em] text-faint">
        <span>Прогресс</span>
        <span data-course-count>—</span>
      </div>
      <div class="h-[3px] bg-line">
        <div class="h-full bg-accent" data-progress-fill style="width: 0%"></div>
      </div>
    </div>
  </div>
</a>
