---
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<section class="not-prose my-5 border-l border-line pl-4">
  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-muted">Действие</p>
  <h3 class="mt-1 font-serif text-lg text-ink">{title}</h3>
  <div class="mt-2 font-serif text-[1.02rem] leading-relaxed text-muted">
    <slot />
  </div>
</section>
