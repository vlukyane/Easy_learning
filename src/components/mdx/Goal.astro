---
interface Props {
  label?: string;
}
const { label = "Цель" } = Astro.props;
---

<aside class="not-prose my-6 border-l-2 border-accent bg-panel px-4 py-3">
  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-accent">{label}</p>
  <div class="mt-2 font-serif text-[1.02rem] leading-relaxed text-ink">
    <slot />
  </div>
</aside>
