---
interface Props {
  path: string;
}
const { path } = Astro.props;
---

<section class="not-prose my-5 bg-panel px-4 py-3">
  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">Скелет</p>
  <p class="mt-1 font-mono text-[12.5px] text-accent">{path}</p>
  <div class="mt-2 space-y-2 font-serif text-[1.02rem] leading-relaxed text-ink [&_p]:my-0 [&_ul]:my-1 [&_ul]:list-disc [&_ul]:pl-5 [&_strong]:font-semibold [&_code]:font-mono [&_code]:text-[0.9em]">
    <slot />
  </div>
</section>
