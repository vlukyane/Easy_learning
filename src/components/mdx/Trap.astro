---
interface Props {
  title?: string;
}
const { title = "Ловушка" } = Astro.props;
---

<aside class="not-prose my-6 border border-line px-4 py-3">
  <p class="font-mono text-[10px] uppercase tracking-[0.18em] text-faint">{title}</p>
  <div class="mt-2 font-serif text-[1.02rem] leading-relaxed text-muted">
    <slot />
  </div>
</aside>
